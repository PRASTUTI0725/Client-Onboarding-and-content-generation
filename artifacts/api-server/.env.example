# Example environment file for API Server
# Copy to .env.local and fill in actual values
# 
# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
# API
API_PORT=3000
API_HOST=0.0.0.0

# LLM providers (optional)
# AI_PROVIDER_CHAIN=groq:llama-3.3-70b-versatile,openrouter:openai/gpt-4o-mini,gemini:gemini-2.0-flash
# AI_MODEL_GEMINI=gemini-2.0-flash
# LLM_PREFLIGHT_OPENROUTER_CREDITS=1

